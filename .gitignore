# Python bytecode (compiled execution caches)
__pycache__/
*.py[cod]

# Python packaging and distribution build artifacts
build/
dist/
*.egg-info/

# Testing, linting and type checking caches
.pytest_cache/
.coverage
.ruff_cache/
.mypy_cache/

# Virtual environments
.venv/
venv/

# IDE settings (optional, keeps your repository clean across editors)
.idea/
.vscode/
.DS_Store
